; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="삼국지 게이트 러너"
run/main_scene="res://scenes/main.tscn"
config/icon="res://assets/ui/app_icon.png"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.043, 0.051, 0.078, 1)
boot_splash/image="res://assets/ui/logo.png"
boot_splash/fullsize=false

[autoload]

DataDb="*res://scripts/data_db.gd"
GameState="*res://scripts/game_state.gd"
Sound="*res://scripts/sound.gd"
Telemetry="*res://scripts/telemetry.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_width"
window/handheld/orientation=1

[gui]

theme/custom="res://scenes/ui/theme.tres"

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
